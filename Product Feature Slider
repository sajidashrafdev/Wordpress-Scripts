add_shortcode('custom_product_gallery', 'render_custom_product_gallery');

function render_custom_product_gallery() {
    ob_start();
    
    $product_id = 3590;
    $product = wc_get_product($product_id);

    if ($product) {
        $thumbnail_id = $product->get_image_id();
        $main_image_url = wp_get_attachment_image_url($thumbnail_id, 'full');
        $gallery_image_ids = $product->get_gallery_image_ids();
        
        // Updated Video URL
        $video_url = 'https://lunasilk.pl/wp-content/uploads/2026/09/Product-video.mp4';
    ?>

    <div class="custom-product-gallery">
      <!-- Main Display Area -->
      <div class="main-display-container">
        <div id="main-image-view" class="main-view active">
          <img id="active-main-img" alt="<?php echo esc_attr($product->get_name()); ?> — główny widok" src="<?php echo esc_url($main_image_url); ?>">
          <span class="zoom-badge">NAJEDŹ, ABY POWIĘKSZYĆ</span>
        </div>
        
        <div id="main-video-view" class="main-view">
          <video id="active-main-video" controls>
            <source src="<?php echo esc_url($video_url); ?>" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>
      </div>

      <!-- Thumbnails Row -->
      <div class="thumbnails-grid" style="grid-template-columns: repeat(<?php echo count($gallery_image_ids) + 2; ?>, 1fr);">
        
        <button type="button" class="thumb-btn active" onclick="switchMedia('image', '<?php echo esc_url($main_image_url); ?>', this)">
          <img src="<?php echo esc_url(wp_get_attachment_image_url($thumbnail_id, 'thumbnail')); ?>" alt="Miniatura Główna">
        </button>

        <?php foreach ($gallery_image_ids as $index => $gallery_id) : 
          $gallery_img_url = wp_get_attachment_image_url($gallery_id, 'full');
          $gallery_thumb_url = wp_get_attachment_image_url($gallery_id, 'thumbnail');
        ?>
          <button type="button" class="thumb-btn" onclick="switchMedia('image', '<?php echo esc_url($gallery_img_url); ?>', this)">
            <img src="<?php echo esc_url($gallery_thumb_url); ?>" alt="Miniatura <?php echo $index + 2; ?>">
          </button>
        <?php endforeach; ?>
        
        <button type="button" class="thumb-btn video-thumb-outline" onclick="switchMedia('video', '', this)" aria-label="Odtwórz film produktowy">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="play-icon-outline"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg>
        </button>
      </div>

      <!-- Badges -->
      <div class="badges-container">
        <span class="badge-item">100% JEDWAB</span>
        <span class="badge-item">KSZTAŁT 3D</span>
        <span class="badge-item">TOTALNE ZACIEMNIENIE</span>
      </div>
    </div>

    <style>
      .custom-product-gallery { width: 100%; max-width: 600px; margin: 0 auto; }
      .main-display-container { position: relative; aspect-ratio: 1 / 1; overflow: hidden; border: 1px solid #333; background-color: #111; }
      .main-view { display: none; width: 100%; height: 100%; opacity: 0; transition: opacity 0.4s ease-in-out; }
      .main-view.active { display: block; opacity: 1; }
      .main-view img, .main-view video { width: 100%; height: 100%; object-fit: cover; }
      .zoom-badge { position: absolute; left: 16px; top: 16px; background: rgba(0, 0, 0, 0.8); padding: 6px 12px; font-size: 10px; letter-spacing: 0.25em; color: #d4af37; border: 1px solid rgba(212, 175, 55, 0.3); z-index: 2; }
      .thumbnails-grid { margin-top: 16px; display: grid; gap: 8px; }
      .thumb-btn { aspect-ratio: 1 / 1; overflow: hidden; border: 1px solid #333; background: #111; padding: 0; cursor: pointer; transition: all 0.3s ease; }
      .thumb-btn img { width: 100%; height: 100%; object-fit: cover; }
      .thumb-btn:hover { border-color: rgba(212, 175, 55, 0.5); }
      .thumb-btn.active { border-color: #d4af37; }
      .video-thumb-outline { display: flex; align-items: center; justify-content: center; background-color: #111 !important; border: 1px solid #333; }
      .video-thumb-outline.active { border-color: #d4af37 !important; background-color: #1a1a1a !important; }
      .play-icon-outline { width: 24px; height: 24px; stroke: #d4af37; fill: none; }
      .badges-container { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
      .badge-item { border: 1px solid rgba(212, 175, 55, 0.3); background: #1a1a1a; padding: 6px 12px; font-size: 10px; letter-spacing: 0.2em; color: #d4af37; }
    </style>

    <script>
      function switchMedia(type, url, element) {
        const buttons = document.querySelectorAll('.thumbnails-grid .thumb-btn');
        buttons.forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');
        
        const imgView = document.getElementById('main-image-view');
        const videoView = document.getElementById('main-video-view');
        const mainImg = document.getElementById('active-main-img');
        const mainVideo = document.getElementById('active-main-video');

        if (type === 'image') {
          videoView.classList.remove('active');
          mainVideo.pause();
          
          // Smooth fade effect on image switch
          mainImg.style.opacity = '0';
          setTimeout(() => {
            mainImg.src = url;
            mainImg.style.opacity = '1';
          }, 150);
          
          imgView.classList.add('active');
        } else if (type === 'video') {
          imgView.classList.remove('active');
          videoView.classList.add('active');
          mainVideo.play();
        }
      }
    </script>
    <?php
    }
    return ob_get_clean();
}


