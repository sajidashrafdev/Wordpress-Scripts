===========>>> Image widget <<<===========

selector {
    overflow: hidden;
}

selector img {
    transition: transform 0.6s ease-in-out;
}

selector:hover img {
    transform: scale(1.03);
}


===========>>> Countainer BG Imgae <<<===========

selector {
    overflow: hidden; /* Yeh image ko container se bahar jaane se roke ga */
    position: relative;
}

selector::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: inherit; /* Container ki background image khud hi utha lega */
    background-size: cover;
    background-position: center;
    transition: transform 0.6s ease-in-out;
    z-index: 0;
}

selector:hover::before {
    transform: scale(1.03); /* Zoom level adjust karne ke liye value change kar sakte hain */
}

/* Agar container ke andar text ya doosre widgets hain toh unko upar rakhne ke liye */
selector > * {
    position: relative;
    z-index: 1;
}
