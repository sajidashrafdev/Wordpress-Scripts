selector .e-filter-item {
    position: relative;
    padding-left: 30px !important;
}

/* Checkbox */
selector .e-filter-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 18px;
    height: 18px;
    border: 1px solid #999;
    border-radius: 4px;
    background: #fff;
    transform: translateY(-50%);
    box-sizing: border-box;
}

/* Checked */
selector .e-filter-item[aria-pressed="true"]::before {
    background: #FF0060;
    border-color: #FF0060;
}

/* Check icon */
selector .e-filter-item[aria-pressed="true"]::after {
    content: "✓";
    position: absolute;
    left: 4px;
    top: 50%;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    transform: translateY(-50%);
}
